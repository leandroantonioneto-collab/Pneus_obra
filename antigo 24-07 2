    await carregarBase();
    $('SUC_BG').className='sucesso-bg '+COR;$('SUC_BTN').className='s-nbtn '+COR;
    $('SUC_DET').innerHTML=Object.entries(res).map(function(e){return '<div class="row"><span>'+e[0]+'</span><b>'+e[1]+'</b></div>';}).join('');
    load(false);show('T_SUCESSO');
  }catch(e){toast('Erro: '+e.message);load(false);btn.disabled=false;console.error(e);}
}
