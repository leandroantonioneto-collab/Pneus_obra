      await api('movimentacoes','','POST',{data:da,pneu_id:parseInt(pn),tipo:'Descarte',cod_equipamento:eq,horimetro_ret:parseFloat(h),sulco_retirada:parseFloat(sl),status_final:'Descartado',responsavel:resp(),usuario_id:U.id,foto_url:fotoUrl,obs_campo:'Motivo: '+_motivoDes+'. Destino: '+(vl('DST')||'-')+'. '+obs});
