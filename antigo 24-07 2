<script>
const SB_URL='https://nskhtlravltryiqzczil.supabase.co';
const SB_KEY='sb_publishable_YWHe6f8puoqhEmkdTOXehA_MZRKC99x';
const BUCKET='FOTOS%20E%20PNEUS';
let U=null,SETOR='eng',FUNC_SEL='',OP=null,FOTO=null,COR='az';
let EQUIPS=[],PNEUS=[],FUNCS_ALM=[],FUNCS_BOR=[];
let _posSel='',_motivoDes='Fim de vida util';
const DIAS=['Domingo','Segunda','Terca','Quarta','Quinta','Sexta','Sabado'];
const $=id=>document.getElementById(id);
const vl=id=>{const e=$(id);return e?e.value.trim():'';}
function show(id){document.querySelectorAll('.tela').forEach(t=>t.classList.remove('on'));$(id).classList.add('on');window.scrollTo(0,0);}
function load(s,t='Aguarde...'){$('LOV').classList[s?'add':'remove']('on');$('LTXT').textContent=t;}
function toast(m,d=2800){const t=$('TOAST');t.textContent=m;t.classList.add('on');setTimeout(()=>t.classList.remove('on'),d);}
function hoje(){const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
function dataHora(){const d=new Date();return DIAS[d.getDay()].slice(0,3)+' '+d.toLocaleDateString('pt-BR')+' '+d.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});}
function resp(){return FUNC_SEL||U&&U.nome||'-';}
async function api(tab,params,method,body){
  params=params||'';method=method||'GET';
  const r=await fetch(SB_URL+'/rest/v1/'+tab+'?'+params,{method:method,headers:{'apikey':SB_KEY,'Authorization':'Bearer '+SB_KEY,'Content-Type':'application/json','Prefer':'return=representation'},body:body?JSON.stringify(body):undefined});
  if(!r.ok){const e=await r.text();throw new Error(e);}
  return method==='GET'?r.json():r;
}
async function upload(file,path){
  const r=await fetch(SB_URL+'/storage/v1/object/'+BUCKET+'/'+path,{method:'POST',headers:{'apikey':SB_KEY,'Authorization':'Bearer '+SB_KEY,'Content-Type':file.type,'x-upsert':'true'},body:file});
  if(!r.ok)throw new Error('Erro no upload');
  return SB_URL+'/storage/v1/object/public/'+BUCKET+'/'+path;
}
function selSetor(s,btn){
  SETOR=s;
  document.querySelectorAll('.setor-btn').forEach(b=>b.classList.remove('on'));
  btn.classList.add('on');
  const fs=$('FUNC_SEL'),lb=$('LOGIN_BTN'),sl=$('SENHA_LBL');
  lb.className='login-btn '+s;
  if(s==='eng'){fs.style.display='none';sl.textContent='Senha do engenheiro';}
  else{
    fs.style.display='block';
    sl.textContent='Senha do '+(s==='alm'?'almoxarifado':'borracharia');
    const lista=s==='alm'?FUNCS_ALM:FUNCS_BOR;
    $('FUNC_CHIPS').innerHTML=lista.length?lista.map((f,i)=>'<div class="chip '+(i===0?'on '+s:'')+'" onclick="selChip(this,\''+f.nome+'\',\''+s+'\')">'+f.nome+'</div>').join(''):'<div style="font-size:.7rem;color:var(--tx2);">Nenhum funcionario cadastrado</div>';
    FUNC_SEL=lista[0]&&lista[0].nome||'';
  }
}
function selChip(el,nome,s){
  el.closest('.chips').querySelectorAll('.chip').forEach(c=>c.className='chip');
  el.className='chip on '+s;FUNC_SEL=nome;
}
async function login(){
  const s=$('SENHA_INP').value.trim();
  if(!s){toast('Informe a senha');return;}
  $('LOGIN_BTN').disabled=true;load(true,'Verificando...');
  try{
    const cargo=SETOR==='eng'?'Engenheiro':SETOR==='alm'?'Almoxarife':'Borracheiro';
    const users=await api('usuarios','cargo=eq.'+cargo+'&ativo=eq.true&select=*');
    let b=null;
    try{const ab=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(s));b=Array.from(new Uint8Array(ab)).map(x=>x.toString(16).padStart(2,'0')).join('');}catch(e){}
    const u=users&&users.find(x=>(x.senha_plain&&x.senha_plain===s)||(b&&x.senha_hash&&x.senha_hash===b));
    if(!u){$('LOGIN_ERR').style.display='block';load(false);$('LOGIN_BTN').disabled=false;return;}
    $('LOGIN_ERR').style.display='none';
    U=u;if(!FUNC_SEL)FUNC_SEL=U.nome;
    localStorage.setItem('CP_U',JSON.stringify(U));localStorage.setItem('CP_S',SETOR);localStorage.setItem('CP_F',FUNC_SEL);
    await carregarBase();irHome();load(false);
  }catch(e){toast('Erro: '+e.message);load(false);$('LOGIN_BTN').disabled=false;}
}
function sair(){localStorage.removeItem('CP_U');U=null;SETOR='eng';FUNC_SEL='';show('T_LOGIN');$('SENHA_INP').value='';}
async function carregarBase(){
  try{
    const res=await Promise.all([api('equipamentos','select=cod,tipo,marca_modelo,medida_padrao&status=eq.Ativo&order=cod'),api('pneus','select=id,numero_fogo,marca,medida,status&order=numero_fogo')]);
    EQUIPS=res[0];PNEUS=res[1];
    const todos=await api('usuarios','select=nome,cargo&ativo=eq.true&order=nome');
    FUNCS_ALM=todos.filter(f=>f.cargo==='Almoxarife');
    FUNCS_BOR=todos.filter(f=>f.cargo==='Borracheiro');
  }catch(e){console.error(e);}
}
async function carregarKPIs(){
  try{
    const r=await Promise.all([api('pneus','status=eq.Em uso&select=id'),api('pneus','status=eq.Recapagem&select=id'),api('pneus','status=eq.Estoque&select=id')]);
    $('KPI_AT').textContent=r[0].length;$('KPI_RC').textContent=r[1].length;$('KPI_ES').textContent=r[2].length;
  }catch(e){}
}
function irHome(){
  const d=new Date(),fn=FUNC_SEL||U.nome;
  $('ENG_GN').textContent='Ola, '+fn.split(' ')[0]+'!';
  $('ENG_GS').textContent=DIAS[d.getDay()]+', '+d.toLocaleDateString('pt-BR')+' - '+U.cargo;
  $('ENG_SUB').textContent=U.cargo;
  $('ALM_CHIPS').innerHTML=FUNCS_ALM.map((f,i)=>'<div class="chip '+(i===0?'on alm':'')+'" onclick="selChipHome(this,\''+f.nome+'\',\'alm\',\'ALM_CHIPS\',\'ALM_SUB\')">'+f.nome+'</div>').join('');
  $('ALM_SUB').textContent='Responsavel: '+(FUNCS_ALM[0]&&FUNCS_ALM[0].nome||'-');
  $('BOR_CHIPS').innerHTML=FUNCS_BOR.map((f,i)=>'<div class="chip '+(i===0?'on bor':'')+'" onclick="selChipHome(this,\''+f.nome+'\',\'bor\',\'BOR_CHIPS\',\'BOR_SUB\')">'+f.nome+'</div>').join('');
  $('BOR_SUB').textContent='Responsavel: '+(FUNCS_BOR[0]&&FUNCS_BOR[0].nome||'-');
  if(U.cargo==='Almoxarife')show('T_HOME_ALM');
  else if(U.cargo==='Borracheiro')show('T_HOME_BOR');
  else show('T_HOME_ENG');
  carregarKPIs();
}
function selChipHome(el,nome,s,chid,subid){
  $(chid).querySelectorAll('.chip').forEach(c=>c.className='chip');
  el.className='chip on '+s;FUNC_SEL=nome;
  $(subid).textContent='Responsavel: '+nome;
}
function irPara(id){show(id);if(id==='T_PARAMS'){selParamTab($('PT_FUNC').previousElementSibling||document.querySelector('.param-tab'),  'PT_FUNC');carregarListaFunc();}}
function voltarForm(){if(U&&U.cargo==='Almoxarife')show('T_HOME_ALM');else if(U&&U.cargo==='Borracheiro')show('T_HOME_BOR');else show('T_HOME_ENG');}
function selParamTab(tab,secId){
  document.querySelectorAll('.param-tab').forEach(t=>{t.style.borderBottomColor='transparent';t.style.color='var(--tx2)';});
  tab.style.borderBottomColor='var(--az2)';tab.style.color='var(--az2)';
  ['PT_FUNC','PT_EQUIP','PT_METAS'].forEach(id=>{$(id).style.display='none';});
  $(secId).style.display='block';
  if(secId==='PT_FUNC')carregarListaFunc();
  if(secId==='PT_EQUIP')carregarListaEquip();
}
async function carregarListaFunc(){
  try{
    const lista=await api('usuarios','select=nome,cargo,ativo&order=nome');
    $('LISTA_FUNC').innerHTML=lista.map(f=>'<div class="lista-item"><div style="font-size:1.2rem;">&#128100;</div><div style="flex:1;"><div style="font-size:.8rem;font-weight:800;">'+f.nome+'</div><div style="font-size:.65rem;color:var(--tx2);margin-top:.08rem;">'+f.cargo+' - '+(f.ativo?'Ativo':'Inativo')+'</div></div></div>').join('');
  }catch(e){$('LISTA_FUNC').innerHTML='<div style="color:var(--rd2);font-size:.75rem;">Erro ao carregar</div>';}
}
async function carregarListaEquip(){
  try{
    const lista=await api('equipamentos','select=cod,tipo,marca_modelo,medida_padrao,status&order=cod');
    $('LISTA_EQUIP').innerHTML=lista.map(e=>'<div class="lista-item"><div style="font-size:1.2rem;">&#128663;</div><div style="flex:1;"><div style="font-size:.8rem;font-weight:800;">'+e.cod+' - '+e.tipo+'</div><div style="font-size:.65rem;color:var(--tx2);margin-top:.08rem;">'+(e.marca_modelo||'-')+' - '+(e.medida_padrao||'-')+'</div></div></div>').join('');
  }catch(e){$('LISTA_EQUIP').innerHTML='<div style="color:var(--rd2);font-size:.75rem;">Erro ao carregar</div>';}
}
async function salvarFuncionario(){
  const nome=vl('NF_NOME'),cargo=vl('NF_CARGO'),senha=vl('NF_SENHA');
  if(!nome||!cargo||!senha){toast('Preencha todos os campos');return;}
  load(true,'Salvando...');
  try{
    let hash='';
    try{const ab=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(senha));hash=Array.from(new Uint8Array(ab)).map(x=>x.toString(16).padStart(2,'0')).join('');}catch(e){}
    await api('usuarios','','POST',{nome:nome,cargo:cargo,senha_hash:hash,senha_plain:senha,ativo:true,login:nome.toLowerCase().replace(/\s+/g,'.').replace(/[^a-z0-9.]/g,'')});
    toast('Funcionario adicionado!');$('NF_NOME').value='';$('NF_SENHA').value='';
    await carregarBase();await carregarListaFunc();
  }catch(e){toast('Erro: '+e.message);}
  load(false);
}
async function salvarEquipamento(){
  const cod=vl('NE_COD'),tipo=vl('NE_TIPO'),marca=vl('NE_MARCA'),medida=vl('NE_MEDIDA');
  if(!cod||!tipo){toast('Preencha codigo e tipo');return;}
  load(true,'Salvando...');
  try{
    await api('equipamentos','','POST',{cod:cod,tipo:tipo,marca_modelo:marca,medida_padrao:medida,status:'Ativo'});
    toast('Equipamento adicionado!');$('NE_COD').value='';$('NE_MARCA').value='';
    await carregarBase();await carregarListaEquip();
  }catch(e){toast('Erro: '+e.message);}
  load(false);
