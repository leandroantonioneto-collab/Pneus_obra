      await api('medicoes_sulco','','POST',regs.length===1?regs[0]:regs);
      res={Operacao:'Medicao Sulco',Equip:eq,Medicoes:regs.length+' posicao(oes)',Horimetro:parseFloat(h).toLocaleString('pt-BR')+'h'};
    }else if(OP==='descarte'){
      var pn=vl('PN'),sl=vl('SL'),eq=vl('EQ'),h=vl('HOR'),da=vl('FD'),obs=vl('OBS');
