  if(op==='descarte')return '<div class="sec"><h3>Qual pneu sera descartado?</h3><div class="field"><label>Pneu (fogo)<span class="req">*</span></label><select id="PN">'+oPn()+'</select></div>'+cfSulco(true,'SL','Sulco no descarte (mm)')+'</div><div class="sec"><h3>Motivo<span class="req">*</span></h3><div class="motivo-grid"><div class="mot-btn on" onclick="selMotivo(this,\'Fim de vida util\')"><span class="mi">&#128202;</span><div class="ml">Fim de vida util</div></div><div class="mot-btn" onclick="selMotivo(this,\'Estouro / Furo\')"><span class="mi">&#128165;</span><div class="ml">Estouro / Furo</div></div><div class="mot-btn" onclick="selMotivo(this,\'Dano lateral / corte\')"><span class="mi">&#9986;</span><div class="ml">Dano lateral</div></div><div class="mot-btn" onclick="selMotivo(this,\'Desgaste irregular\')"><span class="mi">&#9888;</span><div class="ml">Desgaste irregular</div></div><div class="mot-btn" onclick="selMotivo(this,\'Separacao de carcaca\')"><span class="mi">&#128274;</span><div class="ml">Separacao carcaca</div></div><div class="mot-btn" onclick="selMotivo(this,\'Outro\')"><span class="mi">&#128203;</span><div class="ml">Outro motivo</div></div></div></div><div class="sec"><h3>Complemento</h3>'+cfEquip('EQ','')+cfHorim('HOR')+'<div class="field"><label>Destino</label><select id="DST"><option>Sucata / descarte final</option><option>Devolvido ao fornecedor</option><option>Enviado para analise (garantia)</option></select></div>'+cfData+'</div><div class="sec"><h3>Foto<span class="req">*</span></h3>'+cfFoto(true,'FOTO1')+'</div><div class="sec"><h3>Descricao do problema<span class="req">*</span></h3>'+cfObs+'</div>';
  if(op==='falha')return '<div class="sec"><h3>Pneu</h3><div class="field"><label>Pneu (fogo)<span class="req">*</span></label><select id="PN">'+oPn()+'</select></div></div><div class="sec"><h3>Equipamento</h3>'+cfEquip('EQ','')+cfHorim('HOR')+'</div><div class="sec"><h3>Falha</h3><div class="field"><label>Tipo<span class="req">*</span></label><select id="TF"><option value="">Selecione</option>'+TFALHA.map(t=>'<option>'+t+'</option>').join('')+'</select></div><div class="field"><label>Causa<span class="req">*</span></label><select id="CA"><option value="">Selecione</option>'+CAUSAS.map(c=>'<option>'+c+'</option>').join('')+'</select></div><div class="frow"><div class="field"><label>Horas ate falha</label><input type="number" id="HF" step="1"/></div><div class="field"><label>Custo est. R$</label><input type="number" id="CV" step="0.01"/></div></div>'+cfData+'</div><div class="sec"><h3>Foto<span class="req">*</span></h3>'+cfFoto(true,'FOTO1')+'</div><div class="sec"><h3>Descricao</h3>'+cfObs+'</div>';
  return '<div class="sec"><h3>Em construcao</h3></div>';
}
function selMotivo(btn,nome){document.querySelectorAll('.mot-btn').forEach(function(b){b.classList.remove('on');});btn.classList.add('on');_motivoDes=nome;}
async function salvar(){
  var btn=$('SBTN');btn.disabled=true;
  try{
    if(['descarte','falha'].indexOf(OP)>=0&&!FOTO){$('FREQ').style.display='block';toast('Foto obrigatoria');btn.disabled=false;return;}
    load(true,'Enviando...');var fotoUrl=null;
    if(FOTO){load(true,'Enviando foto...');var ext=FOTO.name.split('.').pop()||'jpg';fotoUrl=await upload(FOTO,OP+'/'+U.id+'_'+Date.now()+'.'+ext);}
    load(true,'Salvando...');var res={};
    if(OP==='pneu-novo'){
      var fg=vl('FF').toUpperCase(),mr=vl('MR'),md=vl('MD'),nf=vl('NF'),fo=vl('FOR'),v=vl('VL'),da=vl('FD');
      if(!fg||!mr||!md||!nf||!fo||!v||!da){toast('Campos obrigatorios!');load(false);btn.disabled=false;return;}
      var qtd=parseInt(vl('QTD')||1),regs=[];
      for(var i=0;i<qtd;i++)regs.push({numero_fogo:qtd>1?(fg+'-'+String(i+1).padStart(2,'0')):fg,marca:mr,modelo:vl('MO'),medida:md,dot:vl('DOT'),nota_fiscal:nf,fornecedor:fo,valor_compra:parseFloat(v),data_compra:da,sulco_original:parseFloat(vl('SL')||17),vida_esperada_h:parseInt(vl('VIDA')||3500),status:'Estoque',tipo_entrada:'Compra',foto_url:fotoUrl,observacoes:vl('OBS')});
      await api('pneus','','POST',qtd===1?regs[0]:regs);
      res={Operacao:'Pneu Novo',Fogo:qtd>1?(fg+'-01~'+String(qtd).padStart(2,'0')):fg,Marca:mr+' '+md,NF:nf};
    }else if(OP==='retorno-recap'){
      var pn=vl('PN'),sl=vl('SL'),fo=vl('FOR'),v=vl('VL'),da=vl('FD');
      if(!pn||!sl||!fo||!v||!da){toast('Campos obrigatorios!');load(false);btn.disabled=false;return;}
      await api('pneus','id=eq.'+pn,'PATCH',{status:'Estoque',sulco_original:parseFloat(sl)});
      await api('movimentacoes','','POST',{data:da,pneu_id:parseInt(pn),tipo:'Retorno Recapagem',status_final:'Estoque',responsavel:resp(),usuario_id:U.id,foto_url:fotoUrl,obs_campo:'Recapadeira: '+fo+'. OS: '+(vl('OS')||'-')+'. '+vl('OBS')});
      var ps=PNEUS.find(function(p){return p.id===parseInt(pn);});
      res={Operacao:'Retorno Recapagem',Fogo:(ps&&ps.numero_fogo)||('#'+pn),Sulco:sl+'mm',Recapadeira:fo};
    }else if(OP==='transf-entrada'){
      var fg=vl('FF').toUpperCase(),mr=vl('MR'),md=vl('MD'),ori=vl('ORI'),da=vl('FD');
      if(!fg||!mr||!md||!ori||!da){toast('Campos obrigatorios!');load(false);btn.disabled=false;return;}
      await api('pneus','','POST',{numero_fogo:fg,marca:mr,modelo:vl('MO'),medida:md,dot:vl('DOT'),sulco_original:parseFloat(vl('SL')||0)||null,data_compra:da,status:'Estoque',tipo_entrada:'Transferencia',foto_url:fotoUrl,observacoes:'Origem: '+ori+'. '+vl('OBS')});
      res={Operacao:'Transf. Entrada',Fogo:fg,Origem:ori};
    }else if(OP==='transf-saida'){
      var pn=vl('PN'),ds=vl('DST'),da=vl('FD');
      if(!pn||!ds||!da){toast('Campos obrigatorios!');load(false);btn.disabled=false;return;}
      await api('movimentacoes','','POST',{data:da,pneu_id:parseInt(pn),tipo:'Transferencia Saida',status_final:'Transferido',responsavel:resp(),usuario_id:U.id,foto_url:fotoUrl,obs_campo:'Destino: '+ds+'. '+vl('OBS')});
      var ps=PNEUS.find(function(p){return p.id===parseInt(pn);});
      res={Operacao:'Transf. Saida',Fogo:(ps&&ps.numero_fogo)||('#'+pn),Destino:ds};
    }else if(OP==='inventario'){
      var fg=vl('FF').toUpperCase(),mr=vl('MR'),md=vl('MD'),sl=vl('SL'),eq=vl('EQ'),h=vl('HOR');
      if(!fg||!mr||!md||!sl||!eq||!_posSel||!h){toast('Selecione a posicao no diagrama e preencha todos os campos!');load(false);btn.disabled=false;return;}
      var pr=await api('pneus','','POST',{numero_fogo:fg,marca:mr,modelo:vl('MO'),medida:md,dot:vl('DOT'),sulco_original:parseFloat(vl('SL0')||sl),status:'Em uso',tipo_entrada:'Cadastro campo',foto_url:fotoUrl,observacoes:vl('OBS')});
      var pd=Array.isArray(pr)?pr[0]:pr;
      await api('movimentacoes','','POST',{data:hoje(),pneu_id:pd&&pd.id,tipo:'Montagem',cod_equipamento:eq,posicao:_posSel,horimetro_mont:parseFloat(h),status_final:'Em uso',responsavel:resp(),usuario_id:U.id,foto_url:fotoUrl,obs_campo:'Inventario. '+vl('OBS')});
      res={Operacao:'Inventario',Fogo:fg,Equip:eq,Posicao:_posSel,Sulco:sl+'mm'};
    }else if(OP==='montagem'){
      var pn=vl('PN'),sl=vl('SL'),eq=vl('EQ'),h=vl('HOR'),da=vl('FD');
      if(!pn||!sl||!eq||!_posSel||!h||!da){toast('Selecione a posicao no diagrama!');load(false);btn.disabled=false;return;}
      await api('movimentacoes','','POST',{data:da,pneu_id:parseInt(pn),tipo:'Montagem',cod_equipamento:eq,posicao:_posSel,horimetro_mont:parseFloat(h),sulco_retirada:parseFloat(sl),status_final:'Em uso',responsavel:resp(),usuario_id:U.id,foto_url:fotoUrl,obs_campo:vl('OBS')});
      var ps=PNEUS.find(function(p){return p.id===parseInt(pn);});
      res={Operacao:'Montagem',Fogo:(ps&&ps.numero_fogo)||('#'+pn),Equip:eq,Posicao:_posSel};
    }else if(OP==='remocao'){
      var pn=vl('PN'),eq=vl('EQ'),h=vl('HOR'),da=vl('FD');
      if(!pn||!eq||!h||!da){toast('Campos obrigatorios!');load(false);btn.disabled=false;return;}
      await api('movimentacoes','','POST',{data:da,pneu_id:parseInt(pn),tipo:'Remocao',cod_equipamento:eq,horimetro_ret:parseFloat(h),sulco_retirada:parseFloat(vl('SL')||0)||null,status_final:'Removido',responsavel:resp(),usuario_id:U.id,foto_url:fotoUrl,obs_campo:vl('OBS')});
      var ps=PNEUS.find(function(p){return p.id===parseInt(pn);});
      res={Operacao:'Remocao',Fogo:(ps&&ps.numero_fogo)||('#'+pn),Equip:eq};
    }else if(OP==='recapagem'){
      var pn=vl('PN'),eq=vl('EQ'),h=vl('HOR'),fo=vl('FOR'),da=vl('FD');
      if(!pn||!eq||!h||!fo||!da){toast('Campos obrigatorios!');load(false);btn.disabled=false;return;}
      await api('movimentacoes','','POST',{data:da,pneu_id:parseInt(pn),tipo:'Recapagem',cod_equipamento:eq,horimetro_ret:parseFloat(h),sulco_retirada:parseFloat(vl('SL')||0)||null,valor_recapagem:parseFloat(vl('VL')||0)||null,status_final:'Recapagem',responsavel:resp(),usuario_id:U.id,foto_url:fotoUrl,obs_campo:'Recapadeira: '+fo+'. '+vl('OBS')});
      var ps=PNEUS.find(function(p){return p.id===parseInt(pn);});
      res={Operacao:'Envio Recapagem',Fogo:(ps&&ps.numero_fogo)||('#'+pn),Equip:eq,Recapadeira:fo};
    }else if(OP==='rodizio'){
      var pn=vl('PN'),eq=vl('EQ'),h=vl('HOR'),eq2=vl('EQ2'),da=vl('FD');
      if(!pn||!eq||!h||!eq2||!_posSel||!da){toast('Selecione a posicao de destino no diagrama!');load(false);btn.disabled=false;return;}
      var trf='TRF-'+Date.now();
      await api('movimentacoes','','POST',[{data:da,pneu_id:parseInt(pn),tipo:'Remocao',cod_equipamento:eq,horimetro_ret:parseFloat(h),status_final:'Rodizio',id_transferencia:trf,responsavel:resp(),usuario_id:U.id,foto_url:fotoUrl,obs_campo:vl('OBS')},{data:da,pneu_id:parseInt(pn),tipo:'Rodizio',cod_equipamento:eq2,posicao:_posSel,horimetro_mont:parseFloat(h),status_final:'Em uso',id_transferencia:trf,responsavel:resp(),usuario_id:U.id,foto_url:fotoUrl,obs_campo:vl('OBS')}]);
      var ps=PNEUS.find(function(p){return p.id===parseInt(pn);});
      res={Operacao:'Rodizio',Fogo:(ps&&ps.numero_fogo)||('#'+pn),De:eq,Para:eq2+' - '+_posSel};
    }else if(OP==='sulco'){
      var eq=vl('EQ'),h=vl('HOR'),da=vl('FD');
      if(!eq||!h||!da){toast('Campos obrigatorios!');load(false);btn.disabled=false;return;}
      var inps=document.querySelectorAll('.SI'),regs=[];
      inps.forEach(function(i){var mm=parseFloat(i.value);if(mm>0)regs.push({data:da,cod_equipamento:eq,posicao:i.dataset.pos,sulco_medido:mm,sulco_original:17,pct_desgaste:+((1-mm/17)*100).toFixed(2),horimetro:parseFloat(h),responsavel:resp(),usuario_id:U.id,foto_url:fotoUrl,observacoes:vl('OBS')});});
